# PARIS live-data configuration (directive 7, 30).
# Copy to .env and fill in real values. NEVER commit real secrets.

# --- Real sports data (API-Football / API-Sports) ---
# Get a key at https://www.api-football.com/
API_FOOTBALL_KEY=
# Optional base override (default: https://v3.football.api-sports.io)
# API_FOOTBALL_BASE=https://v3.football.api-sports.io

# --- Real market data (SportsGameOdds or equivalent) ---
# Get a key at https://sportsgameodds.com/
SPORTSGAMEODDS_API_KEY=
# SPORTSGAMEODDS_BASE=https://api.sportsgameodds.com

# --- Database (production target: PostgreSQL) ---
# Example: postgresql+psycopg://user:pass@host:5432/paris
# Leave unset to use the local SQLite dev database (paris.db).
DATABASE_URL=

# --- Tunables ---
# PARIS_MARKET_FRESHNESS=900     # seconds before market data is flagged STALE
# PARIS_HTTP_TIMEOUT=15
# PARIS_HTTP_RETRIES=3
